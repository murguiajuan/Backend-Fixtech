# Copie este archivo como .env y cambie todos los valores marcados.
# .env está excluido de Git y de la imagen Docker.

APP_PORT=8080
MYSQL_PORT=3307

# Credenciales de MySQL para el contenedor local.
MYSQL_ROOT_PASSWORD=CAMBIE_ESTA_CLAVE_ROOT
MYSQL_USER=fixtech
MYSQL_PASSWORD=CAMBIE_ESTA_CLAVE_APP

# Genere uno con: openssl rand -hex 32
FIXTECH_JWT_SECRET=CAMBIE_ESTE_SECRETO_POR_UNO_ALEATORIO_DE_64_CARACTERES

# dev habilita Swagger; prod lo deshabilita y exige configuración externa.
SPRING_PROFILES_ACTIVE=dev
FIXTECH_OPENAPI_HABILITADO=true

# Notificaciones por correo (opcionales).
FIXTECH_CORREO_HABILITADO=false
FIXTECH_CORREO_REMITENTE=no-reply@fixtech.pe
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# Recuperación de contraseña mediante OTP (requiere correo habilitado y SMTP).
FIXTECH_OTP_CODIGO_MINUTOS=10
FIXTECH_OTP_TICKET_MINUTOS=10
FIXTECH_OTP_MAX_INTENTOS=5
FIXTECH_OTP_REENVIO_SEGUNDOS=60
FIXTECH_OTP_MAX_SOLICITUDES_CORREO=3
FIXTECH_OTP_MAX_SOLICITUDES_IP=10
FIXTECH_OTP_VENTANA_MINUTOS=15
FIXTECH_OTP_LIMPIEZA_MS=3600000
